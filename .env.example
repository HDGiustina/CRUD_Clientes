# Copie para .env na raiz e em api/ e ajuste se preciso:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)

# Back-end (Express + Prisma) usa esta URL para chegar ao Postgres do Docker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nogle"

# Porta da API
PORT=3000

# Front-end (Vite) usa esta URL para chamar a API
VITE_API_URL="http://localhost:3000"
