# Copie para .env dentro de api/ e ajuste se mudar usuário/senha/porta no docker-compose.yml
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)

# Usada pelo Prisma para chegar ao Postgres do Docker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nogle"

# Porta da API
PORT=3000
